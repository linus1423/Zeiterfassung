# Eigenes Netz für die Zeiterfassung. Nur die Container darin erreichen die
# Datenbank; nach außen wird ausschließlich der Webport veröffentlicht.
# Die Namensauflösung im Netz macht aus "zeiterfassung-db" die Adresse der
# Datenbank, deshalb steht dieser Name in der DATABASE_URL.
[Unit]
Description=Netz der Zeiterfassung

[Network]
Driver=bridge
