# Konfiguration der Quadlet-Units ohne Geheimnisse.
# Kopieren nach ~/.config/zeiterfassung/zeiterfassung.env und anpassen:
#
#   install -Dm600 deploy/quadlet/zeiterfassung.env.example \
#       ~/.config/zeiterfassung/zeiterfassung.env
#
# Es gilt das Format von "podman --env-file": eine Zuweisung je Zeile, keine
# Anfuehrungszeichen, keine Ersetzung von ${...}, Kommentare nur in eigenen
# Zeilen. Die vollstaendige Liste aller Einstellungen steht in .env.example;
# hier stehen nur die, die im Betrieb gebraucht werden.
#
# DJANGO_SECRET_KEY, DATABASE_URL und das Datenbankpasswort stehen bewusst
# NICHT hier, sondern in "podman secret" (siehe docs/podman-quadlet.md).

DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=zeiterfassung.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://zeiterfassung.example.com
# Hinter einem Reverse Proxy, der HTTPS beendet.
DJANGO_BEHIND_PROXY=true
DJANGO_LOG_LEVEL=INFO

DISPLAY_TIME_ZONE=Europe/Berlin

# Wie lange der Einstiegspunkt auf die Datenbank wartet, bevor er aufgibt.
DATABASE_WAIT_SECONDS=60

MAX_OPEN_ENTRY_HOURS=16
STATUTORY_BREAK_WARNINGS=true
DATA_RETENTION_MONTHS=24

CORRECTION_EMAILS_ENABLED=false
SITE_BASE_URL=https://zeiterfassung.example.com
DJANGO_DEFAULT_FROM_EMAIL=zeiterfassung@example.com
DJANGO_EMAIL_HOST=smtp.example.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_USE_TLS=true
DJANGO_EMAIL_TIMEOUT=10
# Passwort als Datei, siehe DJANGO_EMAIL_HOST_PASSWORD_FILE in der Anleitung.

# --- Anmeldung ------------------------------------------------------------
KEYCLOAK_CLIENT_ID=
KEYCLOAK_SERVER_URL=https://keycloak.example.com/realms/mein-realm
KEYCLOAK_DISPLAY_NAME=Keycloak
ENTRA_CLIENT_ID=
ENTRA_TENANT_ID=
ENTRA_DISPLAY_NAME=Microsoft Entra ID
OIDC_LINK_BY_EMAIL=true

OIDC_GROUP_SYNC=false
OIDC_GROUPS_CLAIM=groups
OIDC_GROUP_SYNC_MODE=add
OIDC_ADMIN_GROUPS_CLAIM=
OIDC_ADMIN_GROUP_SUFFIX=
