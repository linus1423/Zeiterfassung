# Vergessene Stempelungen beenden und die Erinnerungen verschicken (Issue 34).
# Unter Compose läuft dafür ein Dienst mit
# einer Schleife aus "sleep"; unter systemd macht das der zugehörige Timer
# (zeiterfassung-scheduler.timer). Vorteile: der Lauf steht im Journal, er
# lässt sich mit "systemctl start zeiterfassung-scheduler" von Hand auslösen,
# ein ausgefallener Lauf wird nach einem Neustart nachgeholt (Persistent=true),
# und zwischen zwei Läufen läuft kein Container.
#
# Absichtlich ohne [Install]: gestartet wird die Unit nur vom Timer.
[Unit]
Description=Wiederkehrende Aufgaben der Zeiterfassung
Requires=zeiterfassung-db.service
After=zeiterfassung-db.service zeiterfassung-web.service

[Container]
ContainerName=zeiterfassung-scheduler
Image=localhost/zeiterfassung:latest
Network=zeiterfassung.network

EnvironmentFile=%h/.config/zeiterfassung/zeiterfassung.env
Environment=DJANGO_SECRET_KEY_FILE=/run/secrets/django-secret-key
Environment=DATABASE_URL_FILE=/run/secrets/database-url
Secret=zeiterfassung-django-secret-key,type=mount,target=django-secret-key
Secret=zeiterfassung-database-url,type=mount,target=database-url

ReadOnly=true
Tmpfs=/tmp
NoNewPrivileges=true
DropCapability=ALL

# Kein Webserver in diesem Container, also auch nichts anzufragen. Ohne diese
# Zeile würde der Healthcheck aus dem Image greifen und immer fehlschlagen.
HealthCmd=none

# Mit Semikolon verkettet: ein fehlgeschlagenes Kommando hält die übrigen
# nicht auf, der Fehler steht im Journal.
Exec=sh -c "python manage.py close_stale_entries; python manage.py remind_open_entries; python manage.py remind_pending_corrections; python manage.py remind_period_closing; python manage.py send_scheduled_exports"

[Service]
Type=oneshot
