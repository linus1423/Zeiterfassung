# Kopiere diese Datei nach .env und trage echte Werte ein.
# Die .env gehört nicht ins Repository (siehe .gitignore).

# --- Django ---------------------------------------------------------------
DJANGO_DEBUG=true
# Pflicht, sobald DJANGO_DEBUG=false: openssl rand -base64 48
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://zeiterfassung.example.com
# Hinter einem Reverse Proxy (nginx, Traefik) auf true setzen.
DJANGO_BEHIND_PROXY=false
DJANGO_LOG_LEVEL=INFO

# --- Datenbank ------------------------------------------------------------
# Ohne Angabe wird SQLite im Projektverzeichnis benutzt (nur für Entwicklung).
# DATABASE_URL=postgres://zeiterfassung:passwort@db:5432/zeiterfassung

# --- Container ------------------------------------------------------------
# Der Einstiegspunkt des Images wartet beim Start auf die Datenbank und wendet
# danach die Migrationen an, wenn RUN_MIGRATIONS=true gesetzt ist (Compose
# macht das für den Dienst "web").
# WAIT_FOR_DATABASE=true
# DATABASE_WAIT_SECONDS=60
# RUN_MIGRATIONS=false
#
# Geheimnisse dürfen auch als Datei kommen: statt FOO zeigt dann FOO_FILE auf
# den Pfad. Unterstützt für DJANGO_SECRET_KEY, DATABASE_URL,
# DJANGO_EMAIL_HOST_PASSWORD, KEYCLOAK_CLIENT_SECRET und ENTRA_CLIENT_SECRET.
# Gedacht für "podman secret" und "docker secret", siehe
# docs/podman-quadlet.md.
# DJANGO_SECRET_KEY_FILE=/run/secrets/django-secret-key

# --- Anzeige --------------------------------------------------------------
DISPLAY_TIME_ZONE=Europe/Berlin

# --- Fachliche Einstellungen ----------------------------------------------
# Nach so vielen Stunden wird ein vergessener Eintrag automatisch beendet.
MAX_OPEN_ENTRY_HOURS=16
# Hinweis auf die gesetzlichen Pausen, gerechnet über den ganzen Tag.
STATUTORY_BREAK_WARNINGS=true
# Hinweis auf Höchstarbeitszeit (10 h am Tag) und Ruhezeit (11 h zwischen
# zwei Arbeitstagen). Gewarnt wird nur, abgezogen wird nie etwas.
STATUTORY_LIMIT_WARNINGS=true
# Aufbewahrungsfrist für personenbezogene Zeitdaten in Monaten. Danach kann
# `manage.py anonymize_expired_users --apply` die Konten anonymisieren.
DATA_RETENTION_MONTHS=24
# Abstand, in dem der Compose-Dienst "scheduler" vergessene Stempelungen
# beendet (Sekunden).
SCHEDULER_INTERVAL_SECONDS=3600

# --- Benachrichtigungen ---------------------------------------------------
# Ohne Mailserver bleibt es beim Zähler in der Navigation.
CORRECTION_EMAILS_ENABLED=false
# Erinnerungen, bevor ein Fehler entsteht (Issue 34). Sie stehen im Tool
# unter "Hinweise"; eine Mail dazu gibt es nur mit REMINDER_EMAILS_ENABLED.
REMINDER_EMAILS_ENABLED=false
# Anträge auf Gruppenwechsel gehen zuerst an die bisherige, dann an die
# neue Gruppe. Eine Mail dazu gibt es nur mit GROUP_CHANGE_EMAILS_ENABLED.
GROUP_CHANGE_EMAILS_ENABLED=false
# Ab wie vielen Stunden an einem laufenden Eintrag ans Ausstempeln erinnert
# wird. Deutlich unter MAX_OPEN_ENTRY_HOURS, sonst kommt der Hinweis zu spät.
OPEN_ENTRY_REMINDER_HOURS=10
# Nach wie vielen Tagen ein offener Korrekturantrag die Admins erinnert.
PENDING_CORRECTION_REMINDER_DAYS=3
# Nach wie vielen Tagen ein weiter liegengebliebener Antrag zusätzlich die
# System-Admins erreicht. Gehört deutlich über die erste Frist; ein Antrag,
# über den in der Gruppe niemand entscheiden darf, eskaliert ohnehin sofort.
PENDING_CORRECTION_ESCALATION_DAYS=14
# Nach wie vielen Tagen nach Ende eines Zeitraums an den Abschluss erinnert wird.
PERIOD_CLOSING_REMINDER_DAYS=3
# Geplante Exporte (Issue 55). Ohne EXPORT_EMAILS_ENABLED geht nichts hinaus;
# der fällige Lauf steht dann als Fehler am Plan und wird erneut versucht.
EXPORT_EMAILS_ENABLED=false
# Obergrenzen für den Anhang. Wird eine überschritten, kommt statt einer
# abgewiesenen Mail eine verständliche Meldung am Zeitplan.
EXPORT_MAX_ATTACHMENT_MB=10
EXPORT_MAX_ROWS=50000
# Für die Links in den Mails, ohne Schrägstrich am Ende.
SITE_BASE_URL=https://zeiterfassung.example.com
DJANGO_DEFAULT_FROM_EMAIL=zeiterfassung@example.com
DJANGO_EMAIL_HOST=smtp.example.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_USE_TLS=true
DJANGO_EMAIL_TIMEOUT=10

# --- Anmeldung: Keycloak --------------------------------------------------
# Leer lassen, wenn Keycloak nicht benutzt wird.
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_SERVER_URL=https://keycloak.example.com/realms/mein-realm
KEYCLOAK_DISPLAY_NAME=Keycloak
# Redirect-URI in Keycloak eintragen:
# https://zeiterfassung.example.com/accounts/oidc/keycloak/login/callback/

# --- Anmeldung: Microsoft Entra ID ---------------------------------------
# Leer lassen, wenn Entra ID nicht benutzt wird.
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_TENANT_ID=
ENTRA_DISPLAY_NAME=Microsoft Entra ID
# Redirect-URI in Entra eintragen:
# https://zeiterfassung.example.com/accounts/oidc/entra/login/callback/

# Konten über die E-Mail-Adresse zusammenführen, wenn sich derselbe Mensch
# über beide Provider anmeldet. Nur mit vertrauenswürdigen Providern.
OIDC_LINK_BY_EMAIL=true

# --- Notfallzugang für System-Admins --------------------------------------
# Lokale Anmeldung mit Passwort, nur für Konten mit System-Admin-Rolle. Im
# Normalbetrieb ausgeschaltet lassen: dann gibt es die URL gar nicht. Nur
# einschalten, solange der Identity-Provider ausgefallen oder noch nicht
# eingerichtet ist, und danach wieder ausschalten.
EMERGENCY_LOGIN_ENABLED=false
# Fehlversuche je Benutzername und je Absenderadresse, dann gesperrt.
EMERGENCY_LOGIN_MAX_ATTEMPTS=5
EMERGENCY_LOGIN_LOCKOUT_MINUTES=15

# --- Gruppen aus dem Identity-Provider ------------------------------------
# Aus: die Mitgliedschaften werden im Tool gepflegt.
OIDC_GROUP_SYNC=false
OIDC_GROUPS_CLAIM=groups
# add ergänzt nur, replace entzieht auch wieder (aber nur Mitgliedschaften,
# die aus dem Provider stammen).
OIDC_GROUP_SYNC_MODE=add
# Leer: die Admin-Rolle wird im Tool vergeben. Sonst entweder ein eigener
# Claim oder eine Namenskonvention wie "werkstatt-admins".
OIDC_ADMIN_GROUPS_CLAIM=
OIDC_ADMIN_GROUP_SUFFIX=
